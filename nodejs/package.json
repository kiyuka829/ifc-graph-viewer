{
  "name": "ifc-graph-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:python",
    "build": "npm run build:python",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "dev:python": "vite --mode python",
    "dev:browser": "vite --mode browser",
    "build:python": "vue-tsc && vite build --mode python",
    "build:browser": "vue-tsc && vite build --mode browser"
  },
  "dependencies": {
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.3.4",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.0.2",
    "vite": "^8.2.2",
    "vue-tsc": "^2.2.0"
  }
}
